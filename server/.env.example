# ==============================================================================
# Configuration du backend — L'atelier de Nono
# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ce fichier .env ne doit JAMAIS être commité ni exposé publiquement.
# ==============================================================================

# --- Serveur ---
PORT=4000
# Origine autorisée à appeler l'API (votre site en production), ex: https://www.latelierdenono.fr
# Plusieurs origines possibles séparées par une virgule (utile en local + prod).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Destinataire des demandes ---
NOTIFY_EMAIL_TO=contact@latelierdenono.fr
NOTIFY_PHONE_TO=+33600000000

# --- Envoi d'e-mail : choisir UNE solution ------------------------------------

# Option A — Resend (recommandé, simple à mettre en place : https://resend.com)
RESEND_API_KEY=
RESEND_FROM="L'atelier de Nono <commandes@votredomaine.fr>"

# Option B — Gmail (rapide si vous avez déjà une adresse Gmail) :
# 1. Activez la validation en 2 étapes sur le compte Google
# 2. Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
# 3. Collez le mot de passe généré (16 caractères, sans espaces) ci-dessous
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM="L'atelier de Nono <votre-adresse@gmail.com>"

# Option C — Brevo ou autre SMTP générique (OVH, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="L'atelier de Nono <commandes@votredomaine.fr>"

# --- SMS (optionnel) — Twilio ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Anti-spam ---------------------------------------------------------------
# Délai minimum (ms) entre le chargement du formulaire et son envoi.
# En dessous de ce délai, la demande est considérée comme suspecte (bot).
MIN_SUBMIT_DELAY_MS=3000
